# Telegram
API_ID=123456
API_HASH=PASTE_TELEGRAM_API_HASH
BOT_TOKEN=PASTE_BOTFATHER_TOKEN
ADMIN_IDS=123456789

# MongoDB - Telegram file references only
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=anime4u
MONGO_COLLECTION=telegram_files

# Turso - Anime4u.Tamil metadata
TURSO_DATABASE_URL=libsql://YOUR-DATABASE.turso.io
TURSO_AUTH_TOKEN=PASTE_TURSO_AUTH_TOKEN

# Backblaze B2 - Anime Live Site media
B2_APPLICATION_KEY_ID=PASTE_B2_KEY_ID
B2_APPLICATION_KEY=PASTE_B2_APPLICATION_KEY
B2_BUCKET_NAME=PASTE_B2_BUCKET_NAME

# Upload settings
MAX_FILE_SIZE=900000000
PART_SIZE=10485760
SESSION_NAME=anime4u_merged_bot
